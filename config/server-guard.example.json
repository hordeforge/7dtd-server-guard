  "actions": {
    "correct": true,
    "quarantine": {
      "damage": false,
      "containers": false,
      "worldMutation": false
    },
    "kick": false,
    "throttle": true
  },
  "thresholds": {
    "movement.displacement": {
      "max_speed_mps": 10.0,
      "max_accel_mps2": 20.0,
      "latency_window_ms": 200,
      "jitter_allowance_m": 1.0,
      "credit_cap_m": 20.0,
      "debt_grace_m": 10.0
    }
  },
  "evidence": {
    "dir": "ServerGuard/evidence",
    "retentionDays": 30,
    "rotationSizeMB": 64,
    "positionHistoryDays": 7,
    "positionHistorySamplesPerPlayer": 3600
  },
  "identityMap": {
    "path": "ServerGuard/identity-map.json",
    "permissions": "0600"
  },
  "hmacKey": {
    "path": "ServerGuard/hmac.key",
    "rotationDays": 90
  },
  "queues": {
    "actionQueueMax": 4096,
    "evidenceQueueMax": 8192
  },
  "faultGuard": {
    "maxFaults": 5,
    "windowSeconds": 300
  },
  "correction": {
    "cooldownTicks": 20,
    "suspendWindowTicks": 200,
    "maxPerWindow": 3
  },
  "availability": {
    "burst": 200,
    "refillPerSecond": 40,
    "globalCostPerTick": 2000,
    "cost": {
      "tiny": 1,
      "play": 2,
      "state": 5,
      "expensive": 20
    }
  },
  "console": {
    "permissionLevel": "admin"
  },
  "webhook": {
    "enabled": false,
    "evidenceIdsOnly": true,
    "urlEnv": "SERVERGUARD_WEBHOOK_URL"
  },
  "dashboard": {
    "enabled": false,
    "secretEnv": "SERVERGUARD_DASHBOARD_SECRET"
  },
  "metrics": {
    "enabled": true
  }
