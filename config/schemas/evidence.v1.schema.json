{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://7dtd-server-guard/evidence.v1.schema.json",
  "title": "Server Guard evidence stream v1",
  "description": "Append-only JSONL records (docs/SCHEMAS.md -> Evidence stream). One object per line; chainPrev links the hash chain. Machine severity/mode values are lowercase; POLICY.md terms (Hard/Strong/Weak, Observe/Correct/Enforce) are the display vocabulary.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "evidenceEventId": {
      "description": "An evidence record ID, as written in eventId, replaces, causeEventIds, and evidenceIds. Declared once here for the same reason the deny-list is: a reference to a record must be spelled the same way everywhere it is written, and a bare string where a record ID is expected is a reference that resolves to nothing. Every array that names other records (`causeEventIds`, `evidenceIds`) $refs it, so a free-form string cannot ride along in a list whose declared type is an id: an element is an id or it is a rejected record, not a player name pasted into an id field.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "utcInstant": {
      "description": "An instant the writer serialized in UTC, as `utc` and `savedAt` are. `format: date-time` alone admits any offset, and `2026-07-21T12:34:56+02:00` is the shape a serializer emits on a host outside UTC: it names the right moment, but its calendar date is the local one, so it disagrees with the `evidence-<UTC-date>-<seq>.jsonl` segment that holds it and its string no longer sorts by instant. A `Z` terminal makes UTC the only spelling, which is what the segment naming and every reader of the chain assume.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "personalDataDenyList": {
      "description": "Property-name deny-list for every open value bag in this schema. Declared once here so a new sensitive key is added in one place: a second hand-written copy is where a raw identity, address, or credential would slip through. The list holds stems matched anywhere in the key, not whole spellings: an enumerated-spelling list is bypassed by the first variant nobody wrote down (`ipaddress`, `hwaddr`, `clientip` all read as ordinary-looking snake_case and carry exactly what `ip_address` was denied for). Case is covered by the `[a-z_]` charset the key must already match, so the stems are lowercase. A platform id denied for the platform it names is denied for every platform: `steam` covered the SteamID, and `xuid` is the same account under the name the engine's own API uses, so one of the two spellings would otherwise have got through. `name`, `nick`, `handle`, `alias`, `ident`, and `login` deny the display-name family, which is the spelling a detector author reaches for first and which no field-name derivation denies.",
      "type": "string",
      "pattern": "^(?!.*(?:steam|xuid|platform|player|user|account|client|eac|guid|ticket|auth|passwd|password|pass|secret|cred|email|mail|phone|addr|ip|mac|hw|hardware|name|nick|handle|alias|ident|login))[a-z_]+$"
    },
    "personalDataValueDenyList": {
      "description": "Value-shape deny-list for every value a detector or an operator writes into an evidence record, applied to the open value bags and to the bounded free-text fields. The property-name deny-list above closes the key a detector writes; it does not close the value under a key the schema already permits, and a value is exactly where a platform id lands when the key is neutral: `context.note` holds a name, `suppressedReason` holds the id the detector was handed, `audit.reason` holds the name the operator is writing a disposition about. Each shape here is one this project can name as identifying a person: the two spellings of a Steam id, the 64-bit and Xbox forms of the same account, a dotted-quad network address, a MAC address, and a contact address. A display name has no shape, so this is not a name filter and does not pretend to be one; it stops the identifiers a machine can read off the wire. The four dotted decimal groups are read as an address, which also rejects a four-part dotted version string, traded deliberately: a value that reads as an address is rejected at validation, where the cost is a rejected record the writer can see, rather than stored for the retention window. `type` admits the non-string values a bag legitimately holds, and `pattern` applies to strings alone, so a measurement, a boolean, and a null pass on their own type and only a string is inspected.",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "pattern": "^(?!.*(?:\\bSTEAM_[01]:[0-9]+:[0-9]+\\b|\\b7656119[0-9]{10}\\b|\\b253[0-9]{14,17}\\b|\\b[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\b|(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\\b|[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+))([\\s\\S]*)$"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "eventId",
        "chainPrev",
        "utc",
        "monotonicMs",
        "tick",
        "buildId",
        "configHash",
        "sessionEpoch",
        "pseudonym",
        "detectorId",
        "detectorVersion",
        "severity",
        "confidence",
        "mode",
        "context",
        "observations",
        "expected",
        "actual",
        "causeEventIds",
        "action"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "$ref": "#/definitions/evidenceEventId"
        },
        "chainPrev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "const": "finding"
        },
        "utc": {
          "$ref": "#/definitions/utcInstant"
        },
        "monotonicMs": {
          "type": "integer",
          "minimum": 0
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "tickHealthMs": {
          "description": "How far the tick loop ran behind its budget, in milliseconds, taken from the server monotonic clock. The minimum is a contract, not a clamp: a lag measured against the wall clock reads negative when timesync steps the clock, and a negative value here is refused rather than silently floored, so the field must be monotonic-derived (docs/SCHEMAS.md -> Evidence stream).",
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "buildId": {
          "type": "string"
        },
        "configHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hookManifestHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sessionEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "pseudonym": {
          "type": "string",
          "pattern": "^p-[0-9a-f]{8,64}$"
        },
        "entityId": {
          "type": "integer",
          "minimum": 0
        },
        "detectorId": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z_]+$"
        },
        "detectorVersion": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "hard",
            "strong",
            "weak"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "mode": {
          "enum": [
            "observe",
            "correct",
            "enforce"
          ]
        },
        "suppressedReason": {
          "description": "Why a soft finding was not acted on, as a class, not a sentence. Bounded like the other free-text fields in this schema: a suppression reason is the one field a detector author fills by interpolating whatever the game handed it, so an unbounded string here is a channel a name or a quoted line rides into a 30-day record.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "allOf": [
            {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          ]
        },
        "context": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/definitions/personalDataDenyList"
          },
          "additionalProperties": {
            "$ref": "#/definitions/personalDataValueDenyList"
          }
        },
        "observations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "maxProperties": 4,
            "propertyNames": {
              "$ref": "#/definitions/personalDataDenyList"
            },
            "additionalProperties": {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          }
        },
        "expected": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/definitions/personalDataDenyList"
          },
          "additionalProperties": {
            "$ref": "#/definitions/personalDataValueDenyList"
          }
        },
        "actual": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "$ref": "#/definitions/personalDataDenyList"
          },
          "additionalProperties": {
            "$ref": "#/definitions/personalDataValueDenyList"
          }
        },
        "causeEventIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/evidenceEventId"
          }
        },
        "action": {
          "enum": [
            "record",
            "correct",
            "quarantine",
            "throttle",
            "kick",
            "temp-ban-local"
          ]
        },
        "disposition": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "confirmed",
            "benign",
            "uncertain",
            "detector-bug",
            null
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "eventId",
        "chainPrev",
        "causeToken",
        "modIdentity",
        "sessionEpoch",
        "pseudonym",
        "causeEventIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "$ref": "#/definitions/evidenceEventId"
        },
        "chainPrev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "const": "cause"
        },
        "causeToken": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,64}$"
        },
        "modIdentity": {
          "type": "string",
          "maxLength": 128,
          "allOf": [
            {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          ]
        },
        "itemId": {
          "description": "Mod item name, bounded: a mod author names an item with a display string as readily as an id, and an unbounded field would keep it for the full retention window.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "allOf": [
            {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          ]
        },
        "delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "sessionEpoch": {
          "type": "integer",
          "minimum": 0
        },
        "pseudonym": {
          "type": "string",
          "pattern": "^p-[0-9a-f]{8,64}$"
        },
        "causeEventIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/evidenceEventId"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "eventId",
        "chainPrev",
        "scope",
        "savedAt",
        "marker"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "$ref": "#/definitions/evidenceEventId"
        },
        "chainPrev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "const": "reconciliation"
        },
        "scope": {
          "enum": [
            "player",
            "container"
          ]
        },
        "savedAt": {
          "$ref": "#/definitions/utcInstant"
        },
        "replayedFrom": {
          "type": [
            "object",
            "null"
          ],
          "propertyNames": {
            "$ref": "#/definitions/personalDataDenyList"
          },
          "additionalProperties": {
            "$ref": "#/definitions/personalDataValueDenyList"
          }
        },
        "deltaItems": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "maxProperties": 8,
            "propertyNames": {
              "$ref": "#/definitions/personalDataDenyList"
            },
            "additionalProperties": {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          }
        },
        "marker": {
          "description": "Reconciliation marker (a segment label the writer builds), bounded like every other free-text field: the marker names the segment it reconciles, not the player it reconciles for.",
          "type": "string",
          "maxLength": 128,
          "allOf": [
            {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "eventId",
        "chainPrev",
        "configHash",
        "detectors",
        "queueDepth",
        "uptimeS"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "$ref": "#/definitions/evidenceEventId"
        },
        "chainPrev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "const": "health"
        },
        "configHash": {
          "description": "Hash of the effective config this snapshot was produced under, so a detector's mode here and the mode on its findings are read against the same config.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "detectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "detectorId",
              "version",
              "mode",
              "hookResolved",
              "state",
              "faults",
              "findingsThisEpoch"
            ],
            "properties": {
              "detectorId": {
                "type": "string",
                "pattern": "^[a-z]+\\.[a-z_]+$"
              },
              "version": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "observe",
                  "correct",
                  "enforce"
                ]
              },
              "hookResolved": {
                "type": "boolean"
              },
              "state": {
                "enum": [
                  "active",
                  "self-disabled",
                  "fail-open",
                  "off"
                ]
              },
              "faults": {
                "type": "integer",
                "minimum": 0
              },
              "findingsThisEpoch": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "queueDepth": {
          "type": "integer",
          "minimum": 0
        },
        "drops": {
          "type": "integer",
          "minimum": 0
        },
        "faults": {
          "type": "integer",
          "minimum": 0
        },
        "uptimeS": {
          "type": "integer",
          "minimum": 0
        },
        "epochs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "eventId",
        "chainPrev",
        "utc",
        "actor",
        "action",
        "reason",
        "evidenceIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "$ref": "#/definitions/evidenceEventId"
        },
        "chainPrev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "const": "audit"
        },
        "utc": {
          "$ref": "#/definitions/utcInstant"
        },
        "actor": {
          "type": "string",
          "maxLength": 128,
          "allOf": [
            {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          ]
        },
        "action": {
          "enum": [
            "override",
            "unban",
            "purge",
            "config-reload",
            "emergency-disable",
            "appeal-disposition"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "allOf": [
            {
              "$ref": "#/definitions/personalDataValueDenyList"
            }
          ]
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/definitions/evidenceEventId"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "eventId",
        "chainPrev",
        "replaces",
        "reasonClass",
        "payloadHash"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "$ref": "#/definitions/evidenceEventId"
        },
        "chainPrev": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "type": {
          "const": "tombstone"
        },
        "replaces": {
          "$ref": "#/definitions/evidenceEventId"
        },
        "reasonClass": {
          "enum": [
            "operator-purge",
            "erasure-request",
            "retention-expiry"
          ]
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  ]
}
